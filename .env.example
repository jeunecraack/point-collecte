SHEET_CSV_URL=      # défaut dans next.config.ts ; vide → lecture de data/points.csv
REVALIDATE_SECRET=
ADMIN_SECRET=
SIGNALEMENT_WEBHOOK_URL=   # vide → les signalements vont dans les logs serveur
NEXT_PUBLIC_SITE_URL=      # ex. https://points-collecte.vercel.app — pour l'image des aperçus WhatsApp
SHEET_SCRIPT_URL=               # URL « …/exec » de l'Apps Script collé dans le Sheet (scripts/apps-script.gs)
SHEET_SCRIPT_SECRET=            # même valeur que SECRET dans le script
GOOGLE_SERVICE_ACCOUNT_EMAIL=   # compte de service qui écrit l'onglet « signalements »
GOOGLE_PRIVATE_KEY=             # sa clé privée PEM (\n échappés acceptés)
SIGNALEMENTS_SHEET_ID=          # vide → le Sheet public (préférer un Sheet privé)
